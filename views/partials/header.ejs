<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : brand.name %></title>
  <meta name="description" content="Professional corporate training workshops — browse dates, check live seat availability, and book online in minutes.">
  <meta name="theme-color" content="#171717">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23171717'/><path d='M9 11h14M9 16h14M9 21h8' stroke='white' stroke-width='2.2' stroke-linecap='round'/></svg>">
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h9"/>
          </svg>
        </span>
        <%= brand.name %>
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle">
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </label>

      <nav class="nav-links">
        <a href="/workshops" class="nav-link <%= path.startsWith('/workshops') ? 'is-active' : '' %>">Workshops</a>
        <a href="/eoi" class="nav-link <%= path === '/eoi' ? 'is-active' : '' %>">Express interest</a>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/admin/dashboard" class="nav-link <%= path.startsWith('/admin') ? 'is-active' : '' %>">Dashboard</a>
        <% } else if (currentUser) { %>
          <a href="/my-bookings" class="nav-link <%= path === '/my-bookings' ? 'is-active' : '' %>">My bookings</a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <% if (currentUser) { %>
          <a href="/account" class="nav-user">
            <span class="avatar"><%= initials(currentUser.name) %></span>
            <span><%= currentUser.name.split(' ')[0] %></span>
          </a>
          <form action="/logout" method="POST" class="inline-form">
            <button type="submit" class="btn btn-secondary btn-sm">Log out</button>
          </form>
        <% } else { %>
          <a href="/login" class="btn btn-secondary btn-sm">Log in</a>
          <a href="/register" class="btn btn-primary btn-sm">Sign up</a>
        <% } %>
      </div>
    </div>
  </header>

  <main>
    <% if ((success && success.length) || (error && error.length) || (typeof info !== 'undefined' && info.length)) { %>
      <div class="container alert-stack" style="padding-top:24px">
        <% (error || []).forEach(function (msg) { %>
          <div class="alert alert-error" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            <span><%= msg %></span>
          </div>
        <% }); %>
        <% (success || []).forEach(function (msg) { %>
          <div class="alert alert-success" role="status">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:2px"><path d="M20 6L9 17l-5-5"/></svg>
            <span><%= msg %></span>
          </div>
        <% }); %>
        <% (typeof info !== 'undefined' ? info : []).forEach(function (msg) { %>
          <div class="alert alert-info" role="status">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            <span><%= msg %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
