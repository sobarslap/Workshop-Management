<%- include('partials/header') %>

<div class="auth-shell">
  <div class="mesh mesh-sm" aria-hidden="true"></div>
  <div class="container page-tight">
    <div class="auth-card center">
      <div class="result-icon is-good" style="margin-bottom:16px">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/></svg>
      </div>

      <h1 style="font-size:28px;letter-spacing:-1.2px">Check your inbox.</h1>
      <p class="small">
        If an account exists for <strong class="strong"><%= email %></strong>, a password reset
        link is on its way. It expires in an hour.
      </p>

      <a href="/login" class="btn btn-primary btn-block mt-md">Back to log in</a>
    </div>

    <div class="card card-soft mt-md">
      <span class="eyebrow" style="margin-bottom:8px">Not seeing it?</span>
      <p class="small mb-0">
        Check your spam folder first. If no SMTP server is configured, the app writes every
        email to <code>data/outbox/</code> and prints the reset link to the server console
        instead &mdash; look there when running locally.
      </p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
