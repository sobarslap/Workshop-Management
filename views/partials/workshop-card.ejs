<%
  // Expects: w (workshop row with seats_remaining / capacity)
  const remaining = Math.max(0, w.seats_remaining);
  const taken = Math.max(0, w.capacity - remaining);
  const pct = w.capacity > 0 ? Math.min(100, Math.round((taken / w.capacity) * 100)) : 0;
  const full = remaining <= 0;
  const low = !full && remaining / w.capacity <= 0.25;
  const past = isPast(w.workshop_date);
%>
<article class="wcard <%= full || past ? 'is-full' : '' %>">
  <div class="wcard-top"></div>
  <div class="wcard-body">
    <div class="wcard-meta">
      <% if (w.level) { %><span class="badge badge-outline"><%= w.level %></span><% } %>
      <% if (past) { %>
        <span class="badge badge-neutral">Date passed</span>
      <% } else if (full) { %>
        <span class="badge badge-failed"><span class="dot"></span>Fully booked</span>
      <% } else if (low) { %>
        <span class="badge badge-pending"><span class="dot"></span>Only <%= remaining %> left</span>
      <% } else { %>
        <span class="badge badge-paid"><span class="dot"></span><%= remaining %> seats open</span>
      <% } %>
    </div>

    <h3><a href="/workshops/<%= w.id %>"><%= w.title %></a></h3>
    <p class="wcard-desc"><%= w.description %></p>

    <div class="wcard-facts">
      <span class="wfact">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <%= formatDate(w.workshop_date) %>
        <span class="muted">· <%= relativeDays(w.workshop_date) %></span>
      </span>
      <% if (w.start_time) { %>
        <span class="wfact">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <%= w.start_time %><%= w.end_time ? ' – ' + w.end_time : '' %>
        </span>
      <% } %>
      <% if (w.location) { %>
        <span class="wfact">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= w.location %>
        </span>
      <% } %>
    </div>

    <div style="margin-bottom:12px">
      <div class="meter" role="img" aria-label="<%= taken %> of <%= w.capacity %> seats taken">
        <div class="meter-fill <%= full ? 'is-full' : (low ? 'is-low' : '') %>" style="width:<%= pct %>%"></div>
      </div>
      <div class="meter-legend">
        <span><%= taken %>/<%= w.capacity %> booked</span>
        <span><%= pct %>%</span>
      </div>
    </div>

    <div class="wcard-foot">
      <div>
        <div class="price"><%= money(w.price) %></div>
        <div class="price-unit">per seat</div>
      </div>
      <% if (past) { %>
        <span class="btn btn-secondary btn-sm" aria-disabled="true">Closed</span>
      <% } else if (full) { %>
        <a href="/eoi?workshop_id=<%= w.id %>" class="btn btn-secondary btn-sm">Join waitlist</a>
      <% } else { %>
        <a href="/workshops/<%= w.id %>" class="btn btn-primary btn-sm">View &amp; book</a>
      <% } %>
    </div>
  </div>
</article>
