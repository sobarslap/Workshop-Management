<%- include('partials/header') %>

<div class="auth-shell">
  <div class="mesh mesh-sm" aria-hidden="true"></div>
  <div class="container" style="max-width:540px;position:relative;z-index:1">
    <div class="auth-card">
      <div class="auth-head">
        <span class="eyebrow">Get started</span>
        <h1>Create your account.</h1>
        <p class="muted small">Free, and takes about a minute. Required before you can book a seat.</p>
      </div>

      <form method="POST" action="/register" class="stack" novalidate>
        <div class="field">
          <label class="label" for="name">Full name <span class="req">*</span></label>
          <input class="input" type="text" id="name" name="name" required autofocus
                 value="<%= form.name || '' %>" placeholder="Ayesha Karim" autocomplete="name">
        </div>

        <div class="field">
          <label class="label" for="email">Work email <span class="req">*</span></label>
          <input class="input" type="email" id="email" name="email" required
                 value="<%= form.email || '' %>" placeholder="ayesha@acme.com" autocomplete="email">
          <p class="help">Confirmations and receipts are sent here.</p>
        </div>

        <div class="grid-2">
          <div class="field">
            <label class="label" for="company">Company <span class="label-hint">(optional)</span></label>
            <input class="input" type="text" id="company" name="company"
                   value="<%= form.company || '' %>" placeholder="Acme Ltd" autocomplete="organization">
          </div>
          <div class="field">
            <label class="label" for="phone">Phone <span class="label-hint">(optional)</span></label>
            <input class="input" type="tel" id="phone" name="phone"
                   value="<%= form.phone || '' %>" placeholder="01XXXXXXXXX" autocomplete="tel">
          </div>
        </div>

        <div class="field">
          <label class="label" for="password">Password <span class="req">*</span></label>
          <div class="password-wrap">
            <input class="input" type="password" id="password" name="password" required
                   placeholder="At least 8 characters" autocomplete="new-password">
            <button type="button" class="password-toggle" data-password-toggle="password" aria-label="Show password">Show</button>
          </div>
          <div class="strength" data-strength-for="password" data-score="0">
            <div class="strength-track">
              <span class="strength-seg"></span><span class="strength-seg"></span>
              <span class="strength-seg"></span><span class="strength-seg"></span>
            </div>
            <span class="strength-label">Use 8+ characters with a letter and a number.</span>
          </div>
        </div>

        <div class="field">
          <label class="label" for="confirm_password">Confirm password <span class="req">*</span></label>
          <div class="password-wrap">
            <input class="input" type="password" id="confirm_password" name="confirm_password" required
                   placeholder="Type it again" autocomplete="new-password" data-match-for="password">
            <button type="button" class="password-toggle" data-password-toggle="confirm_password" aria-label="Show password">Show</button>
          </div>
          <p id="confirm_password-hint" class="help"></p>
        </div>

        <div class="field">
          <label class="check">
            <input type="checkbox" name="remember" value="1">
            <span>Keep me logged in on this device</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">Create account</button>

        <p class="help center mb-0">
          By creating an account you agree to our booking terms and cancellation policy.
        </p>
      </form>

      <div class="auth-foot">
        Already registered? <a href="/login">Log in instead</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
