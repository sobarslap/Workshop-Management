<%- include('partials/header') %>

<div class="auth-shell">
  <div class="mesh mesh-sm" aria-hidden="true"></div>
  <div class="container page-tight">
    <div class="auth-card">
      <div class="auth-head">
        <span class="eyebrow">Account recovery</span>
        <h1>Forgot your password?</h1>
        <p class="muted small">Enter the email on your account and we'll send you a link to set a new password.</p>
      </div>

      <form method="POST" action="/forgot-password" class="stack" novalidate>
        <div class="field">
          <label class="label" for="email">Email address</label>
          <input class="input" type="email" id="email" name="email" required autofocus
                 value="<%= form.email || '' %>" placeholder="you@company.com" autocomplete="email">
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">Send reset link</button>
      </form>

      <div class="auth-foot">
        Remembered it? <a href="/login">Back to log in</a>
      </div>
    </div>

    <p class="auth-aside">
      The link works once and expires after an hour. Resetting your password also signs you
      out of every remembered device.
    </p>
  </div>
</div>

<%- include('partials/footer') %>
