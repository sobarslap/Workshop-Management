# =============================================================================
# Corporate Workshops — environment configuration
#
# Copy this file to `.env` and adjust. Every value below has a working default,
# so the app runs correctly with no .env file at all.
# =============================================================================

# ---------- App ----------
PORT=3000
# Must match the URL the browser actually uses — payment gateways redirect back
# to it. When tunnelling for IPN testing, put the ngrok URL here.
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

BRAND_NAME=Corporate Workshops
BRAND_TAGLINE=Professional training, booked in seconds.
SUPPORT_EMAIL=training@corporateworkshops.test
SUPPORT_PHONE=+880 1700 000000

CURRENCY=BDT
# Minutes an unpaid booking holds its seat before it is released automatically.
SEAT_HOLD_MINUTES=30

# ---------- Authentication ----------
REMEMBER_ME_DAYS=30
RESET_TOKEN_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# =============================================================================
# PAYMENTS
#
# Pick one: sandbox | sslcommerz | bkash
#
#   sandbox     Built-in gateway. No credentials, no internet, no signup. Serves
#               its own hosted checkout page and verifies payments server-side
#               exactly like the real providers. This is the default.
#
#   sslcommerz  Real SSLCommerz v4 gateway. Free sandbox store at
#               https://developer.sslcommerz.com/
#
#   bkash       Real bKash Tokenized Checkout. Sandbox credentials at
#               https://developer.bka.sh/
#
# If the chosen provider is missing its credentials, the app logs a warning and
# falls back to `sandbox` rather than breaking the booking flow.
# =============================================================================
PAYMENT_GATEWAY=sandbox

# ---------- Built-in sandbox gateway ----------
# Fake network delay (ms) so the redirect feels like a real one. 0 = instant.
SANDBOX_LATENCY_MS=600

# ---------- SSLCommerz ----------
# Sandbox store. SSLCommerz issues the password when the store is created; the
# usual convention is "<store_id>@ssl", so try corpo6a89104f1a961@ssl first and
# check the merchant panel at https://developer.sslcommerz.com/ if it is refused.
SSLCZ_STORE_ID=corpo6a89104f1a961
SSLCZ_STORE_PASSWORD=corpo6a89104f1a961@ssl
SSLCZ_IS_LIVE=false
SSLCZ_TIMEOUT_MS=20000

# ---------- bKash ----------
# bKash's public Tokenized Checkout sandbox credentials. These are published by
# bKash for testing and are shared by every developer — they are not secret and
# they only work against the sandbox host. Replace them with the credentials
# from your Relationship Manager before going live.
BKASH_APP_KEY=4f6o8c51l1r7m34hfdadileqg
BKASH_APP_SECRET=1ls7hdktrmkvrb1jjh4411h8lldtjodqasmjve5vl5qz3fug9b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_IS_LIVE=false
BKASH_TIMEOUT_MS=20000

# bKash sandbox test wallets (see docs/PAYMENTS.md for the full table):
#   success            01770618576, 01929918378, 01877722345
#   insufficient funds 01823074817
#   debit blocked      01823074818
#   PIN 12121   OTP 123456

# =============================================================================
# EMAIL
#
# Leave SMTP_HOST empty and every message is printed to the console AND written
# to data/outbox/ as an openable .html file. That is deliberate: the EOI
# acknowledgment and booking confirmation can still be demonstrated with no mail
# server, no internet, and no credentials.
#
# For real delivery with Gmail, use an App Password (not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Corporate Workshops <no-reply@corporateworkshops.test>"
